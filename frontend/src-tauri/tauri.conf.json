{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Atelier Cuisine",
  "version": "1.0.0",
  "identifier": "fr.ateliercuisine.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Atelier Cuisine",
        "width": 1180,
        "height": 800,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true,
        "backgroundColor": "#110b14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://hcdiuxznceuixindcvhp.supabase.co wss://hcdiuxznceuixindcvhp.supabase.co http://localhost:11434 http://127.0.0.1:11434; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Lifestyle",
    "shortDescription": "Courses, repas et péremptions",
    "longDescription": "Liste de courses, suivi des repas, idées de plats selon ce qu'il reste et alertes de péremption.",
    "copyright": "Atelier Cuisine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}